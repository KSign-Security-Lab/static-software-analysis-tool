// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/*
=========================
Enums
=========================
*/

enum ASTEdgeGroup {
  AST_PC
  AST_SB
  AST_GUARD
}

enum FlowType {
  BASE
  INDEX
  SIZE
  VALUE
}

enum GuardType {
  IF
  LOOP
  NONE
}

enum GraphType {
  AST
  CPG
  DFG
  TEMPLATE
}

/* =========================
Core Graph (no type)
========================= */

model Graph {
  id String @id @default(cuid())

  // Graph type
  type GraphType

  // Use sourceFile as the primary identity (pair with versionTag if needed)
  sourceFile String
  versionTag String? // set when you want multiple versions per file

  // Integrity / provenance
  contentHash String? @unique
  meta        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Children
  astNodes ASTNode[]
  astEdges ASTEdge[]
  dfgNodes DFGNode[]
  dfgEdges DFGEdge[]

  // If you need multiple versions per file, use the composite unique below.
  // If you want exactly one graph per sourceFile, change this to @@unique([sourceFile]).
  @@unique([sourceFile, versionTag])
  @@index([sourceFile])
  @@index([versionTag])
}

/*
=========================
AST Models
=========================
*/

model ASTNode {
  id      String @id @default(cuid())
  graphId String
  graph   Graph  @relation(fields: [graphId], references: [id], onDelete: Cascade)

  // Original per-graph identifiers
  sid    Int // stable per-graph id for AST
  origId BigInt? // optional, large values supported

  // Content
  nodeType String?
  code     String?
  features Json?
  debug    Json?

  // Relations (back-references for ASTEdge)
  outgoingEdges ASTEdge[] @relation("ASTEdgeSrc")
  incomingEdges ASTEdge[] @relation("ASTEdgeDst")

  // Uniqueness within a graph so edges can reference by sid
  @@unique([graphId, sid])
  // Helpful indexes
  @@index([graphId, nodeType])
  @@index([graphId, origId])
}

model ASTEdge {
  id      String @id @default(cuid())
  graphId String
  graph   Graph  @relation(fields: [graphId], references: [id], onDelete: Cascade)

  edgeGroup ASTEdgeGroup

  // Address nodes by (graphId, sid)
  srcSid  Int
  dstSid  Int
  srcNode ASTNode? @relation("ASTEdgeSrc", fields: [graphId, srcSid], references: [graphId, sid], onDelete: Cascade)
  dstNode ASTNode? @relation("ASTEdgeDst", fields: [graphId, dstSid], references: [graphId, sid], onDelete: Cascade)

  // Edge semantics
  kind        Int
  guardKind   Int?
  guardBranch Int?
  features    Json?
  properties  Json?

  // Prevent duplicates of the same semantic edge within a graph
  @@unique([graphId, edgeGroup, srcSid, dstSid, kind])
  // Helpful indexes
  @@index([graphId, srcSid, dstSid])
  @@index([graphId, edgeGroup, kind])
}

/* =========================
DFG Models
========================= */

model DFGNode {
  id      String @id @default(cuid())
  graphId String
  graph   Graph  @relation(fields: [graphId], references: [id], onDelete: Cascade)

  // Original per-graph identifier from IDFGNode.id
  origId Int

  // Flattened features for fast filtering/analytics
  templateNodeType              String
  inDegreeDFG                   Int
  outDegreeDFG                  Int
  defCount                      Int
  useCount                      Int
  isBufferAccess                Boolean
  isSinkAssignment              Boolean
  isSinkCallUnbounded           Boolean
  isSinkCallBounded             Boolean
  callDestinationIndexed        Boolean
  callLengthLinkedToDestination Boolean
  callSizeNonConstant           Boolean
  callDangerUnbounded           Boolean

  debug Json?

  // Relations (back-references for DFGEdge)
  outgoingEdges DFGEdge[] @relation("DFGEdgeSrc")
  incomingEdges DFGEdge[] @relation("DFGEdgeDst")

  // Unique within its graph for stable addressing
  @@unique([graphId, origId])
  // Helpful indexes
  @@index([graphId, templateNodeType])
  @@index([graphId, inDegreeDFG])
}

model DFGEdge {
  id      String @id @default(cuid())
  graphId String
  graph   Graph  @relation(fields: [graphId], references: [id], onDelete: Cascade)

  // Address nodes by (graphId, origId)
  srcOrigId Int
  dstOrigId Int
  srcNode   DFGNode? @relation("DFGEdgeSrc", fields: [graphId, srcOrigId], references: [graphId, origId], onDelete: Cascade)
  dstNode   DFGNode? @relation("DFGEdgeDst", fields: [graphId, dstOrigId], references: [graphId, origId], onDelete: Cascade)

  // Edge features
  flow                    FlowType
  guard                   GuardType
  hasLowerGuard           Boolean
  hasUpperGuard           Boolean
  upperGuardNormalization Float

  debug Json?

  // Avoid duplicate semantic edges
  @@unique([graphId, srcOrigId, dstOrigId, flow, guard])
  // Helpful indexes
  @@index([graphId, srcOrigId, dstOrigId])
  @@index([graphId, flow, guard])
}
