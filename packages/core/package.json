{
  "name": "@ssat/core",
  "version": "2.4.3",
  "description": "",
  "type": "module",
  "scripts": {
    "start:ast": "cd ../.. && PYTHONPATH=. python -m uvicorn packages.core.ast.server:app --reload --reload-dir packages/core --port 8000",
    "start:joern": "joern --server --server-host 0.0.0.0 --server-port 8080",
    "generate:cpg": "helpers/shell/package-json.sh --mode cpg",
    "generate:template": "helpers/shell/package-json.sh --mode template",
    "generate:ast": "helpers/shell/package-json.sh --mode ast",
    "generate:dfg": "helpers/shell/package-json.sh --mode dfg",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.10.2",
    "eslint": "^9.27.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  },
  "dependencies": {
    "zod": "^3.25.67"
  }
}