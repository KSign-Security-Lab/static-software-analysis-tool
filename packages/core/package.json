{
  "name": "@ssat/core",
  "version": "2.4.3",
  "description": "Static Software Analysis Tool Core Processing Modules",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./endpoint": {
      "types": "./endpoint/index.ts",
      "default": "./endpoint/index.ts"
    },
    "./types/*": "./types/*"
  },
  "scripts": {
    "scripts:help": "node -e \"const p=JSON.parse(require('fs').readFileSync('./packages/core/package.json','utf8')); const i=p.scriptsInfo||{}; console.log('Core scripts\\n==========='); for (const [k,v] of Object.entries(i)) console.log(k.padEnd(20),' - ',v);\"",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:log": "jest --json --outputFile=test-results.json --verbose"
  },
  "scriptsInfo": {
    "scripts:help": "List Core workspace scripts with descriptions",
    "type-check": "Type-check Core workspace",
    "lint": "Run ESLint",
    "lint:fix": "Run ESLint with --fix",
    "format": "Run Prettier write",
    "format:check": "Run Prettier check",
    "test": "Run Core tests",
    "test:watch": "Run Core tests in watch mode",
    "test:coverage": "Run Core tests with coverage",
    "test:log": "Run Core tests with logging"
  },
  "dependencies": {
    "python-shell": "^5.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/python-shell": "^0.4.2",
    "eslint": "^9.27.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "jest": "^29.5.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  }
}
