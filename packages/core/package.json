{
  "name": "@ssat/core",
  "version": "2.4.3",
  "description": "",
  "type": "module",
  "scripts": {
    "generate:cpg": "sh -c 'python helpers/runner.py --mode cpg  --data \"${npm_config_data:?use --data=<path>}\"  ${npm_config_output:+--output \"$npm_config_output\"}'",
    "generate:kast": "sh -c 'python helpers/runner.py --mode kast --data \"${npm_config_data:?use --data=<path>}\"  ${npm_config_output:+--output \"$npm_config_output\"}'",
    "generate:full": "sh -c 'ts=$(date +%Y%m%d-%H%M%S); tmp=${npm_config_tmp:-tmp/$ts}; final=${npm_config_output:-result/${ts}-final}; data=\"${npm_config_data:?use --data=<path>}\"; python helpers/runner.py --mode cpg --data \"$data\" --output \"$tmp\" && python helpers/runner.py --mode kast --data \"$tmp\" --output \"$final\" && rm -rf \"$tmp\" && echo \"Final output: $final\"'",
    "generate:dfg": "sh -c 'python helpers/runner.py --mode dfg --data \"${npm_config_data:?use --data=<path>}\"  ${npm_config_output:+--output \"$npm_config_output\"}'",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.10.2",
    "eslint": "^9.27.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  },
  "dependencies": {
    "zod": "^3.25.67"
  }
}