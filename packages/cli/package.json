{
  "name": "@ssat/cli",
  "version": "2.4.3",
  "description": "Static Software Analysis Tool CLI",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "ssat": "src/index.js"
  },
  "scripts": {
    "generate:cpg": "tsx src/index.ts cpg",
    "generate:template": "tsx src/index.ts template",
    "generate:ast": "tsx src/index.ts ast",
    "generate:dfg": "tsx src/index.ts dfg",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@ssat/core": "workspace:*",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.10.2",
    "eslint": "^9.27.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  }
}