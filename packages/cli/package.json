{
  "name": "@ssat/cli",
  "version": "2.4.3",
  "description": "Static Software Analysis Tool CLI",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "scripts:help": "node -e \"const p=JSON.parse(require('fs').readFileSync('./packages/cli/package.json','utf8')); const i=p.scriptsInfo||{}; console.log('CLI scripts\\n=========='); for (const [k,v] of Object.entries(i)) console.log(k.padEnd(20),' - ',v);\"",
    "generate:cpg": "tsx src/index.ts cpg",
    "generate:template": "tsx src/index.ts template",
    "generate:ast": "tsx src/index.ts ast",
    "generate:dfg": "tsx src/index.ts dfg",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "upload": "tsx src/upload.ts",
    "upload:graph": "tsx src/upload.ts graph",
    "upload:bulk": "tsx src/upload.ts bulk"
  },
  "scriptsInfo": {
    "scripts:help": "List CLI workspace scripts with descriptions",
    "generate:cpg": "Generate CPG graph from input",
    "generate:template": "Generate Template graph from input",
    "generate:ast": "Generate AST graph from input",
    "generate:dfg": "Generate DFG graph from input",
    "type-check": "Type-check CLI workspace",
    "lint": "Run ESLint",
    "lint:fix": "Run ESLint with --fix",
    "format": "Run Prettier write",
    "format:check": "Run Prettier check",
    "test": "Run CLI tests (if present)",
    "upload": "Run upload command entry",
    "upload:graph": "Upload a single graph JSON",
    "upload:bulk": "Upload all JSON files in a directory"
  },
  "dependencies": {
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "zod": "^3.25.67",
    "@ssat/core": "*",
    "@ssat/prisma": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.10.2",
    "eslint": "^9.27.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  }
}