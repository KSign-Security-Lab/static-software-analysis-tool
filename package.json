{
  "name": "static-software-analysis-tool",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "type-check": "npm run -ws --if-present type-check",
    "lint": "npm run -ws --if-present lint",
    "lint:fix": "npm run -ws --if-present lint:fix",
    "format": "npm run -ws --if-present format",
    "format:check": "npm run -ws --if-present format:check",
    "test": "npm -ws --if-present test",
    "generate:cpg": "npm -w @ssat/core run generate:cpg",
    "generate:kast": "npm -w @ssat/core run generate:kast",
    "generate:full": "npm -w @ssat/core run generate:full",
    "generate:dfg": "npm -w @ssat/core run generate:dfg"
  },
  "engines": {
    "node": ">=18.17 <23"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keonoh00/static-software-analysis-tool.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/keonoh00/static-software-analysis-tool/issues"
  },
  "homepage": "https://github.com/keonoh00/static-software-analysis-tool#readme"
}
