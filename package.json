{
  "name": "@ssat/root",
  "private": true,
  "workspaces": [
    "packages/cli",
    "packages/core",
    "packages/agent",
    "web"
  ],
  "scripts": {
    "generate:cpg": "yarn workspace @ssat/cli generate:cpg",
    "generate:template": "yarn workspace @ssat/cli generate:template",
    "generate:dfg": "yarn workspace @ssat/cli generate:dfg",
    "generate:ast": "yarn workspace @ssat/cli generate:ast",
    "type-check": "yarn workspaces run --if-present type-check",
    "lint": "yarn workspaces run --if-present lint",
    "lint:fix": "yarn workspaces run --if-present lint:fix",
    "format": "yarn workspaces run --if-present format",
    "format:check": "yarn workspaces run --if-present format:check",
    "test": "yarn workspaces run --if-present test",
    "start:ast": "yarn workspace @ssat/core start:ast",
    "start:joern": "yarn workspace @ssat/core start:joern",
    "start:all": "concurrently \"yarn start:joern\" \"yarn start:ast\" \"yarn web:dev\" --names \"Joern,AST,Web\" --prefix-colors \"blue,green,yellow\"",
    "web:dev": "yarn workspace @ssat/web dev",
    "web:build": "yarn workspace @ssat/web build",
    "web:start": "yarn workspace @ssat/web start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.17 <23"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keonoh00/static-software-analysis-tool.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/keonoh00/static-software-analysis-tool/issues"
  },
  "homepage": "https://github.com/keonoh00/static-software-analysis-tool#readme"
}