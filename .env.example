# Copy to .env and edit. scripts/up.sh writes the vLLM half of this itself.
#
# Every value here has a working default in the committed files, so a fresh
# checkout runs without this file at all. What it carries is where *this*
# machine keeps things -- nothing machine-specific belongs in compose or in
# Python.

# -- the model ---------------------------------------------------------------
VLLM_MODEL=openai/gpt-oss-20b
VLLM_TOOL_PARSER=openai
VLLM_GPUS=0
VLLM_TP=1
HF_HOME=${HOME}/.cache/huggingface

# -- SEC-bench ---------------------------------------------------------------
# Defaults are ./artifacts/secbench and ./artifacts/secbench/docker.
#
# The dataset is 3.7MB; the evaluation images are around 200GB, which is why
# they get their own daemon (the `secbench` compose profile) rather than the
# host's. Point these at a disk with room. If that disk is shared, use a
# directory this account owns rather than its root.
SECB_ROOT=./artifacts/secbench
SECB_DOCKER_ROOT=./artifacts/secbench/docker

# Which split, and how much of it. SECB_LIMIT=10 is the sensible first sweep:
# the full 200 is days of wall time.
# SECB_SPLIT=cve
# SECB_LIMIT=10
# SECB_PRUNE=1        # remove each image once scored; 0 keeps them
# SECB_CONTEXT=sanitizer
