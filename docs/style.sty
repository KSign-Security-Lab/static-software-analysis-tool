\ProvidesPackage{ksigntech}[2025/11/26 KSIGN technical style]

% ---------- Encoding ----------
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}

% ---------- Korean + Nanum ----------
\RequirePackage[utf]{kotex}
\RequirePackage{dhucs-nanumfont}

% ---------- Modern Latin font (sans) ----------
\RequirePackage{lmodern}
\renewcommand{\familydefault}{\sfdefault}

% ---------- Layout / graphics ----------
\RequirePackage[left=25mm,right=25mm,top=30mm,bottom=40mm]{geometry}
\RequirePackage{graphicx}
\RequirePackage{array}
\RequirePackage{makecell}
\RequirePackage{booktabs}
\RequirePackage{multirow}
\RequirePackage{url}
\RequirePackage{tabularx}
\RequirePackage{lastpage}
\RequirePackage{indentfirst}
\RequirePackage{float}
\RequirePackage{setspace}
\setstretch{1.3}
\setlength{\parindent}{2em}  % indent size (adjust freely)
\setlength{\parskip}{0pt}    % no extra space between paragraphs

% ---------- TOC / lists / captions ----------
\RequirePackage{tocloft}
\RequirePackage{caption}

% ---------- Code Snippets ----------
\RequirePackage{listings}
\RequirePackage{xcolor}

\definecolor{codebg}{RGB}{245,245,245}
\definecolor{codekeyword}{RGB}{0,0,180}
\definecolor{codestring}{RGB}{163,21,21}
\definecolor{codecomment}{RGB}{0,128,0}


\lstdefinelanguage{TypeScript}{
  keywords={typeof, new, true, false, catch, function, return, null, catch, switch, var, if, in, while, do, else, case, break, const, let, export, interface, class, extends, public, private, protected, import, from, as, number, string, boolean, any, void},
  keywordstyle=\color{blue}\bfseries,
  ndkeywords={class, export, boolean, throw, implements, import, this},
  ndkeywordstyle=\color{teal}\bfseries,
  identifierstyle=\color{black},
  sensitive=true,
  comment=[l]{//},
  morecomment=[s]{/*}{*/},
  commentstyle=\color{gray}\ttfamily,
  stringstyle=\color{red}\ttfamily,
  morestring=[b]',
  morestring=[b]"
}

\lstset{
    basicstyle=\ttfamily\small,
    backgroundcolor=\color{codebg},
    frame=single,
    framerule=0pt,
    framesep=12pt,
    xleftmargin=24pt,
    xrightmargin=24pt,
    columns=fullflexible,
    keepspaces=true,
    breaklines=true,
    breakatwhitespace=false,  % <-- changed
    tabsize=4,
    showstringspaces=false,
    keywordstyle=\color{codekeyword}\bfseries,
    stringstyle=\color{codestring},
    commentstyle=\color{codecomment}\itshape,
    escapeinside={(*@}{@*)} % (*@ 와 @*) 사이의 내용은 LaTeX로 처리 (한글 출력 가능)
}

% ---------- Header/Footer packages ----------
\RequirePackage{fancyhdr}
\RequirePackage{eso-pic}
\pagestyle{fancy}
\fancyhf{} % clear all
\setlength{\headheight}{70pt}
\setlength{\headsep}{10pt}
\renewcommand{\headrulewidth}{0pt}

% ---------- Section titles ----------
\RequirePackage{titlesec}


\titleformat{\section}
  {\bfseries\Large}
  {\thesection.}{0.5em}{}

\titleformat{\subsection}
  {\bfseries\large}
  {\thesubsection.}{0.5em}{}

\titleformat{\subsubsection}
  {\bfseries\large}
  {\thesubsubsection.}{0.5em}{}

% Names
\renewcommand{\contentsname}{\textless 목\ \ 차\textgreater}
\renewcommand{\listfigurename}{\textless 그\ 림\ \ 목\ \ 차\textgreater}
\renewcommand{\listtablename}{\textless 표\ \ 목\ \ 차\textgreater}

\renewcommand{\cfttoctitlefont}{\hfill\large\bfseries}
\renewcommand{\cftaftertoctitle}{\hfill}
\renewcommand{\cftloftitlefont}{\hfill\large\bfseries}
\renewcommand{\cftafterloftitle}{\hfill}
\renewcommand{\cftlottitlefont}{\hfill\large\bfseries}
\renewcommand{\cftafterlottitle}{\hfill}

\setlength{\cftaftertoctitleskip}{1cm}
\setlength{\cftafterloftitleskip}{1cm}
\setlength{\cftafterlottitleskip}{1cm}

% ---------- TOC depth (sections only) ----------
\setcounter{tocdepth}{2}

% ---------- Hyperlinks (must be loaded last) ----------
\RequirePackage[unicode=true,bookmarks=true,bookmarksnumbered=true,colorlinks=false,pdfborder={0 0 0},linktoc=all]{hyperref}
\RequirePackage{bookmark}

\endinput